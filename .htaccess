# Configuracion del servidor (Hostinger / Apache-LiteSpeed)
AddDefaultCharset UTF-8
Options -Indexes

# Herramientas internas y documentacion: no se sirven al publico
RedirectMatch 404 ^/(tools|partials)(/|$)
<FilesMatch "^(README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# El dominio temporal de Hostinger (y cualquier *.hostingersite.com) no debe aparecer en buscadores
<IfModule mod_headers.c>
  SetEnvIfNoCase Host "hostingersite\.com$" MM_NOINDEX=1
  Header set X-Robots-Tag "noindex, nofollow" env=MM_NOINDEX
</IfModule>

# Direcciones del sitio anterior (WordPress) que ahora viven en paginas nuevas
RedirectMatch 301 ^/contact/?$ /contacto.html
RedirectMatch 301 ^/tienda/?$ /descargables.html