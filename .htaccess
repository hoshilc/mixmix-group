# Configuracion del servidor (Hostinger / Apache-LiteSpeed)
AddDefaultCharset UTF-8
Options -Indexes

# Herramientas internas y documentacion: no se sirven al publico
RedirectMatch 404 ^/(tools|partials)(/|$)
<FilesMatch "^(README\.md|\.gitignore|netlify\.toml)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Cache: las paginas siempre se revisan (asi un cambio se ve al instante); css/js llevan ?v=huella en el enlace
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# El dominio temporal de Hostinger (y cualquier *.hostingersite.com) no debe aparecer en buscadores
<IfModule mod_headers.c>
  SetEnvIfNoCase Host "hostingersite\.com$" MM_NOINDEX=1
  Header set X-Robots-Tag "noindex, nofollow" env=MM_NOINDEX
</IfModule>

# Direcciones del sitio anterior (WordPress) que ahora viven en paginas nuevas
RedirectMatch 301 ^/contact/?$ /contacto.html
RedirectMatch 301 ^/tienda/?$ /descargables.html

# Una sola direccion oficial: www.grupomixmix.com -> grupomixmix.com
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.grupomixmix\.com$ [NC]
RewriteRule ^(.*)$ https://grupomixmix.com/$1 [R=301,L]